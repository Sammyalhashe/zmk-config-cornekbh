#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4
#define NUM 5

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

#define COMBO_TIMING timeout-ms = <40>; require-prior-idle-ms = <150>;

#define TAP_MACRO(name, keys) \
    name: name { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_tap keys>; };

/ {
    behaviors {
        // A mod only activates when the next key is on the opposite hand or a thumb.
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        ctrl_bracket: ctrl_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT_BRACKET>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        vim_wq: vim_wq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        vim_gg: vim_gg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp G>, <&macro_tap>, <&kp G>;
        };

        vim_big_g: vim_big_g {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(G)>;
        };

        // Neovim leader (Space) sequences; they only act in normal mode.
        TAP_MACRO(nv_files, &kp SPACE &kp F &kp F)
        TAP_MACRO(nv_git_files, &kp SPACE &kp P &kp F)
        TAP_MACRO(nv_grep, &kp SPACE &kp A &kp G)
        TAP_MACRO(nv_buffers, &kp SPACE &kp B)
        TAP_MACRO(nv_resume, &kp SPACE &kp M &kp R)
        TAP_MACRO(nv_tree, &kp SPACE &kp E)
        TAP_MACRO(nv_lazygit, &kp SPACE &kp G &kp G)
        TAP_MACRO(nv_jjui, &kp SPACE &kp G &kp J)
        TAP_MACRO(nv_undotree, &kp SPACE &kp U &kp T)
        TAP_MACRO(nv_prev_error, &kp LEFT_BRACKET &kp E)
        TAP_MACRO(nv_next_error, &kp RIGHT_BRACKET &kp E)
        TAP_MACRO(nv_prev_hunk, &kp LEFT_BRACKET &kp C)
        TAP_MACRO(nv_next_hunk, &kp RIGHT_BRACKET &kp C)
        TAP_MACRO(nv_source_header, &kp RIGHT_BRACKET &kp H)
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DELETE>;
            key-positions = <15 21>;
            COMBO_TIMING
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
            COMBO_TIMING
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 16>;
            COMBO_TIMING
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
            COMBO_TIMING
            layers = <0>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
            COMBO_TIMING
            layers = <0>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
            COMBO_TIMING
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 14>;
            COMBO_TIMING
            layers = <0>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
            COMBO_TIMING
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
            COMBO_TIMING
            layers = <0>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
            COMBO_TIMING
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <31 19>;
            COMBO_TIMING
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
            COMBO_TIMING
            layers = <0>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            COMBO_TIMING
            layers = <0>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
            COMBO_TIMING
            layers = <0>;
        };

        extra_layer {
            bindings = <&mo EXTRA>;
            key-positions = <36 37>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
            COMBO_TIMING
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // | TAB  |  Q   |  W   |  E   |  R   |  T  |   |  Y  |  U   |  I   |  O   |  P   | BKSP |
            // | ESC  | A/GUI| S/ALT| D/CTL| F/SFT|  G  |   |  H  | J/SFT| K/CTL| L/ALT| ;/GUI|  '   |
            // | CTRL |  Z   |  X   |  C   |  V   |  B  |   |  N  |  M   |  ,   |  .   |  /   | SHFT |
            //                      | GUI  | NAV  | SPC |   | ENT | SYM  | ALT  |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R    &kp T        &kp Y    &kp U    &kp I         &kp O    &kp P     &kp BACKSPACE
&kp ESCAPE  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G        &kp H    &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V    &kp B        &kp N    &kp M    &kp COMMA     &kp DOT  &kp FSLH  &kp LSHFT
                          &kp LGUI  &mo NAV  &kp SPACE    &kp RET  &mo SYM  &kp LEFT_ALT
            >;
        };

        NAV {
            display-name = "Nav";

            // -----------------------------------------------------------------------------------------
            // |      | Home | PgUp | End  | PgDn |      |   | :wq  | gg   | G  | Ctrl+[ | Tab | S-Tab |
            // | ESC  | GUI  | ALT  | CTRL | SHFT |      |   | LEFT | DOWN | UP | RIGHT  |     |       |
            // | CTRL | Undo | Cut  | Copy | Paste| Redo |   |  :   |  w   | q  |  g     |  /  | SHFT  |
            //                      | GUI  | ---- | SPC  |   | ENT  | SYM  | ALT |

            bindings = <
&trans      &kp HOME  &kp PAGE_UP  &kp END   &kp PAGE_DOWN  &trans       &vim_wq    &vim_gg   &vim_big_g    &ctrl_bracket  &kp TAB   &kp LS(TAB)
&kp ESCAPE  &kp LGUI  &kp LALT     &kp LCTRL &kp LSHFT      &trans       &kp LEFT   &kp DOWN  &kp UP        &kp RIGHT      &trans    &trans
&kp LCTRL   &kp LG(Z) &kp LG(X)    &kp LG(C) &kp LG(V)      &kp LG(LS(Z))  &kp COLON  &kp W     &kp Q         &kp G          &kp FSLH  &kp LSHFT
                                   &kp LGUI  &trans         &kp SPACE    &kp RET    &mo SYM   &kp LEFT_ALT
            >;
        };

        SYM {
            display-name = "Programming";

            // -----------------------------------------------------------------------------------------
            // |  \  |  {  |  }  |  (  |  )  |  <  |   |  >  |  "  |  '  |  `  |  +  |  -  |
            // |  @  |  [  |  ]  |  ;  |  :  |  =  |   |  %  |  &  |  |  |  ^  |  !  |  *  |
            // |  ~  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  =  |
            //                   | GUI | NAV | SPC |   | ENT | --- | ALT |

            bindings = <
&kp BACKSLASH  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN    &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp GRAVE  &kp PLUS  &kp MINUS
&kp AT         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON         &kp COLON              &kp EQUAL        &kp PERCENT       &kp AMPS           &kp PIPE          &kp CARET  &kp EXCL  &kp STAR
&kp TILDE      &kp N1            &kp N2             &kp N3                &kp N4                 &kp N5           &kp N6            &kp N7             &kp N8            &kp N9     &kp N0    &kp EQUAL
                                                    &kp LGUI              &mo NAV                &kp SPACE        &kp RET           &trans             &kp LEFT_ALT
            >;
        };

        ADJ {
            display-name = "Function/Media";

            // Reached by holding NAV + SYM.
            // | F1    | F2   | F3     | F4   | F5   | F6   |   | F7  | F8  | F9  | F10 | F11  | F12      |
            // | Mouse⇄| Prev | Play   | Next | Vol+ | Vol- |   | :wq | BT1 | BT2 | BT3 | BT4  | BT5      |
            // | Num⇄  | Boot | Studio |      |      |      |   |     |     |     |     | Boot | BT clear |
            //                         | GUI  | ---  | SPC  |   | ENT | --- | ALT |

            bindings = <
&kp F1  &kp F2          &kp F3            &kp F4      &kp F5        &kp F6          &kp F7   &kp F8  &kp F9        &kp F10  &kp F11      &kp F12
&tog EXTRA  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP  &kp C_VOL_DN    &vim_wq  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&tog NUM    &bootloader     &studio_unlock    &trans      &trans        &trans          &trans   &trans  &trans        &trans   &bootloader  &bt BT_CLR
                                          &kp LGUI    &trans        &kp SPACE       &kp RET  &trans  &kp LEFT_ALT
            >;
        };

        EXTRA {
            display-name = "Mouse/Nvim";

            // Hold both left thumbs (GUI + NAV), or toggle from ADJ. Nvim keys send Space-leader sequences.
            // |      |  |    |   |     | Scrl↑ |   | Files | GitFiles | Grep   | Buffers | Resume   |  |
            // | Exit |  |    | M↑ |    | Scrl↓ |   | Tree  | LClick   | RClick | LazyGit | jjui     | ]h (src/hdr) |
            // |      |  | M← | M↓ | M→ |       |   | [e    | ]e       | [c     | ]c      | Undotree |  |
            //                |    | ---| ---   |   | FloatTerm (Ctrl+\) |  |  |

            bindings = <
&trans      &trans  &trans          &trans          &trans           &msc SCRL_UP      &nv_files       &nv_git_files   &nv_grep       &nv_buffers     &nv_resume    &trans
&tog EXTRA  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_DOWN    &nv_tree        &mkp LCLK       &mkp RCLK      &nv_lazygit     &nv_jjui      &nv_source_header
&trans      &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &nv_prev_error  &nv_next_error  &nv_prev_hunk  &nv_next_hunk   &nv_undotree  &trans
                                    &trans          &trans           &trans            &kp LC(BSLH)    &trans          &trans
            >;
        };

        NUM {
            display-name = "Numpad";

            // Toggled from ADJ; tap the bottom-left key again to exit.
            // |      |  |  |  |  |  |   |  | 7 | 8 | 9 | - |  |
            // |      |  |  |  |  |  |   |  | 4 | 5 | 6 | + |  |
            // | Exit |  |  |  |  |  |   |  | 1 | 2 | 3 | . |  |
            //               |  |  |  |   |  | 0 |   |

            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans    &trans  &kp N7  &kp N8  &kp N9  &kp MINUS  &trans
&trans    &trans  &trans  &trans  &trans  &trans    &trans  &kp N4  &kp N5  &kp N6  &kp PLUS   &trans
&tog NUM  &trans  &trans  &trans  &trans  &trans    &trans  &kp N1  &kp N2  &kp N3  &kp DOT    &trans
                          &trans  &trans  &trans    &trans  &kp N0  &trans
            >;
        };
    };
};
