#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        ctrl_bracket: ctrl_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT_BRACKET>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        vim_wq: vim_wq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        vim_gg: vim_gg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp G>,
                <&macro_tap>,
                <&kp G>;
        };

        vim_big_g: vim_big_g {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LS(G)>;
        };

    };

    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DELETE>;
            key-positions = <15 21>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 16>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
            layers = <0>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 14>;
            layers = <0>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
            layers = <0>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
            layers = <0>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <31 19>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
            layers = <0>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            layers = <0>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
            layers = <0>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
            layers = <0>;
        };

        para-great {
            bindings = <&paragreat>;
            key-positions = <20 21>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | ESC | CTRL | NAV | SPC | FNS |   | ENT | PROG | BKSP | ALT | GUI |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U      &kp I          &kp O    &kp P     &kp BACKSPACE
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LGUI   &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M      &kp COMMA      &kp DOT  &kp FSLH  &mo EXTRA
                         &kp ESCAPE  &kp LCTRL  &mo NAV      &kp SPACE  &lt ADJ TAB  &kp RET
            >;
        };

        NAV {
            display-name = "Nav";

            // -----------------------------------------------------------------------------------------
            // | TAB | Home | PgUp | End | PgDn |   | :wq | gg | G | Ctrl+[ | Tab | Shift+Tab |
            // |     | LEFT | DOWN | UP  | RIGHT|   | H   | J | K | L |     |     |
            // |     |     |     |     |     |   |     |     |     |     |     |     |
            // | ESC | CTRL | NAV | SPC | FNS |   | ENT | PROG | BKSP | ALT | GUI |

            bindings = <
&trans  &kp HOME   &kp PAGE_UP  &kp END     &kp PAGE_DOWN  &trans      &vim_wq   &vim_gg     &vim_big_g  &ctrl_bracket  &kp TAB   &kp LS(TAB)
&trans  &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT      &trans      &kp LEFT  &kp DOWN    &kp UP      &kp RIGHT      &trans    &trans
&trans  &trans     &trans       &trans       &trans         &trans      &kp COLON &kp W       &kp Q       &kp G          &trans    &trans
                            &kp ESCAPE  &kp LCTRL    &kp SPACE     &kp RET   &lt SYM TAB  &kp LEFT_ALT
            >;
        };

        SYM {
            display-name = "Programming";

            // -----------------------------------------------------------------------------------------
            // | ESC |  {  |  }  |  (  |  )  |  <  |  >  |  "  |  '  |  `  |  +  |  - |
            // |     |  [  |  ]  |  ;  |  :  |  =  |  %  |  &  |  |  |  ^  |  !  |  * |
            // |     |  /  |  ?  |  @  |  #  |  $  |  .  |  ,  |  ~  |  _  |  \\ |     |
            // | ESC | CTRL | NAV | SPC | FNS |   | ENT | PROG | BKSP | ALT | GUI |

            bindings = <
&kp ESCAPE  &kp LEFT_BRACE      &kp RIGHT_BRACE     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp GRAVE   &kp PLUS  &kp MINUS
&trans       &kp LEFT_BRACKET    &kp RIGHT_BRACKET   &kp SEMICOLON         &kp COLON              &kp EQUAL      &kp PERCENT       &kp AMPS           &kp PIPE          &kp CARET   &kp EXCL  &kp STAR
&trans       &kp SLASH           &kp QUESTION        &kp AT                &kp HASH               &kp DLLR       &kp DOT           &kp COMMA          &kp TILDE         &kp UNDER   &kp BSLH  &trans
                                       &kp ESCAPE          &kp LCTRL              &kp SPACE      &kp RET           &trans             &kp LEFT_ALT
            >;
        };

        ADJ {
            display-name = "Function/Media";
            bindings = <
&kp F1   &kp F2     &kp F3    &kp F4    &kp F5    &kp F6      &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12
&trans   &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &kp C_VOL_UP &trans  &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans     &trans    &trans    &kp C_VOL_DN  &trans    &trans   &trans   &trans   &trans   &bootloader  &trans
                              &kp ESCAPE  &kp LCTRL  &kp SPACE  &kp RET  &trans  &trans
            >;
        };
        EXTRA {
                display-name = "Extra";
            bindings = <
&trans  &trans       &trans         &trans          &trans      &msc SCRL_UP    &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans       &trans        &mmv MOVE_UP      &trans   &msc SCRL_DOWN            &trans  &mkp LCLK  &mkp RCLK  &trans  &trans       &trans
&trans  &trans       &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans      &trans            &trans  &trans  &trans
            >;
        };
    };

};
