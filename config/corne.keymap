#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        ctrl_bracket: ctrl_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT_BRACKET>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        vim_wq: vim_wq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        vim_gg: vim_gg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp G>, <&macro_tap>, <&kp G>;
        };

        vim_big_g: vim_big_g {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(G)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        adj_layer {
            bindings = <&mo ADJ>;
            key-positions = <32 35>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <15 21>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 16>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
            layers = <0>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 14>;
            layers = <0>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
            layers = <0>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
            layers = <0>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <31 19>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
            layers = <0>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            layers = <0>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
            layers = <0>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
            layers = <0>;
        };

        ADJ_Layer {
            bindings = <&to 3>;
            key-positions = <37 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // | TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | GUI |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            // |     | LGUI | NAV | SPC |     |   | ENT | SYM | BKSP | ALT |      |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R    &kp T        &kp Y    &kp U    &kp I         &kp O    &kp P     &kp BACKSPACE
&kp ESCAPE  &kp A  &kp S  &kp D     &kp F    &kp G        &kp H    &kp J    &kp K         &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V    &kp B        &kp N    &kp M    &kp COMMA     &kp DOT  &kp FSLH  &kp LSHFT
                          &kp LGUI  &mo NAV  &kp SPACE    &kp RET  &mo SYM  &kp LEFT_ALT
            >;
        };

        NAV {
            display-name = "Nav";

            // -----------------------------------------------------------------------------------------
            // | TAB | Home | PgUp | End | PgDn |   | :wq | gg | G | Ctrl+[ | Tab | Shift+Tab |
            // | ESC | LEFT | DOWN | UP  | RIGHT|   | H   | J | K | L |     |     |
            // | GUI |     |     |     |     |   |     |     |     |     |     | / | SHFT |
            // | LGUI | NAV | SPC |   | ENT | SYM | BKSP | ALT |

            bindings = <
&trans      &kp HOME  &kp PAGE_UP  &kp END   &kp PAGE_DOWN  &trans       &vim_wq    &vim_gg   &vim_big_g    &ctrl_bracket  &kp TAB   &kp LS(TAB)
&kp ESCAPE  &kp LEFT  &kp DOWN     &kp UP    &kp RIGHT      &trans       &kp LEFT   &kp DOWN  &kp UP        &kp RIGHT      &trans    &trans
&kp LCTRL   &trans    &trans       &trans    &trans         &trans       &kp COLON  &kp W     &kp Q         &kp G          &kp FSLH  &kp LSHFT
                                   &kp LGUI  &trans         &kp SPACE    &kp RET    &mo SYM   &kp LEFT_ALT
            >;
        };

        SYM {
            display-name = "Programming";

            // -----------------------------------------------------------------------------------------
            // | TAB |  {  |  }  |  (  |  )  |  <  |  >  |  "  |  '  |  `  |  +  |  - |
            // | ESC |  [  |  ]  |  ;  |  :  |  =  |  %  |  &  |  |  |  ^  |  !  |  * |
            // | GUI |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  | SHFT |
            // | LGUI | NAV | SPC |   | ENT | SYM | BKSP | ALT |

            bindings = <
&kp BACKSLASH  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN    &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp GRAVE  &kp PLUS  &kp MINUS
&kp AT         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON         &kp COLON              &kp EQUAL        &kp PERCENT       &kp AMPS           &kp PIPE          &kp CARET  &kp EXCL  &kp STAR
&kp LGUI       &kp N1            &kp N2             &kp N3                &kp N4                 &kp N5           &kp N6            &kp N7             &kp N8            &kp N9     &kp N0    &kp EQUAL
                                                    &kp LGUI              &mo NAV                &kp SPACE        &kp RET           &trans             &kp LEFT_ALT
            >;
        };

        ADJ {
            display-name = "Function/Media";
            bindings = <
&kp F1  &kp F2          &kp F3            &kp F4      &kp F5        &kp F6          &kp F7   &kp F8  &kp F9        &kp F10  &kp F11      &kp F12
&trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP  &kp C_VOL_DN    &vim_wq  &trans  &trans        &trans   &trans       &trans
&trans  &trans          &trans            &trans      &trans        &trans          &trans   &trans  &trans        &trans   &bootloader  &trans
                                          &kp LGUI    &trans        &kp SPACE       &kp RET  &trans  &kp LEFT_ALT
            >;
        };

        EXTRA {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans          &trans          &trans           &msc SCRL_UP      &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_DOWN    &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &trans  &trans     &trans     &trans  &trans  &trans
                                &trans          &trans           &trans            &trans  &trans     &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans    &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans        &trans    &trans        &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
                                    &trans        &trans        &trans    &trans        &trans        &trans
            >;
        };
    };
};
